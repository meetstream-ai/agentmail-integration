# AgentMail: https://console.agentmail.to
AGENTMAIL_API_KEY=
# The agent's address; invites sent here get a bot.
# No inbox yet? python scripts/create_inbox.py my-notetaker
AGENTMAIL_INBOX_ID=notetaker@agentmail.to
# Printed by scripts/register_webhook.py
AGENTMAIL_WEBHOOK_SECRET=

# MeetStream: https://app.meetstream.ai
MEETSTREAM_API_KEY=
BOT_NAME=AgentMail Notetaker
# meetstream (built in) or deepgram (connect Deepgram in MeetStream first)
TRANSCRIPT_PROVIDER=meetstream

# The model that writes the notes: openai, grok or gemini. Set the key for the one you pick.
LLM_PROVIDER=openai
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Grok: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public https URL of this server (e.g. from `ngrok http 8000`)
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# REQUIRED. Who may send the agent into meetings: addresses or @domain, comma-separated.
# Invites from anyone else are ignored without a reply, so put your own address here.
ALLOWED_SENDERS=you@example.com,@yourcompany.com

# Google Calendar (optional; step by step in docs/calendar-setup.md): an OAuth
# "Web application" client from Google Cloud with
# http://localhost:8000/calendar/callback as an authorised redirect URI.
# Connect a calendar at http://localhost:8000/calendar (only from this machine).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only calendar meetings with this in the title or description get a bot.
# Empty joins every meeting on the calendar.
CALENDAR_TAG=#notetaker

# Outlook / Microsoft 365 (optional; step by step in docs/calendar-setup.md): a
# Microsoft Entra app registration open to work and personal accounts, platform
# "Web", redirect URI http://localhost:8000/calendar/outlook/callback, delegated
# Graph permissions offline_access, openid, profile, email, User.Read, Calendars.Read.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts work, school and personal accounts; a single-tenant app uses its tenant id
MICROSOFT_TENANT_ID=common

# Hosted deployments: the OAuth redirect URIs on your own address (see docs/deploy.md)
# GOOGLE_REDIRECT_URI=https://notes.example.com/calendar/callback
# MICROSOFT_REDIRECT_URI=https://notes.example.com/calendar/outlook/callback

# Hosted deployments only: a long random string. Sign in once at
# https://your-host/calendar/login to reach the calendar pages. Empty keeps them
# reachable from this machine only.
ADMIN_TOKEN=
